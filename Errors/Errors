errors:
kubectl describe pod <name> -n <ns>
    FailedKillPod
    FailedMount
    FailedUnmount
    NodeNotReady


troubleshooting:
    kubectl get events -n <ns> --sort-by='.lastTimestamp'     -->check recent namespace events
    kubectl describe pod <pod-name> -n <ns>
    kubectl get pod <pod-name> -n <ns> -o yaml

    kubectl delete pod <pod-name> -n <ns> --grace-period=0  --force